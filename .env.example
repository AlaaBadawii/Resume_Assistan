# AgentRouter OpenAI-compatible Responses API configuration.
# Copy to .env, adjust, then load into the shell environment:
#   set -a; source .env; set +a
# No automatic .env loader is bundled; values are read from process
# environment variables only. Never commit a real .env file (.gitignore
# excludes it; this example file is explicitly whitelisted).

# Required — API key from the AgentRouter console (placeholder shown).
AGENTROUTER_API_KEY=sk-ar-replace-with-your-key

# Optional overrides (defaults shown).
# Base URL: HTTPS, valid host/port and unreserved API base path; no URL
# credentials, query, fragment, or /responses suffix. HTTP is allowed only
# for numeric loopback integration-test endpoints. Redirects are rejected.
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# AGENTROUTER_MODEL=gpt-6.1-sol
# Timeout must be a finite positive number (NaN/infinity are rejected).
# AGENTROUTER_TIMEOUT_SECONDS=60
