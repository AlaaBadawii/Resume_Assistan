# LLM Provider Configuration (.env.example)
# Copy to .env, replace the placeholder key for your chosen provider, and
# keep .env private (excluded by .gitignore; never commit a real .env file).
#
# - Local Gradio Web UI (`python main.py`) automatically reads a root .env
#   file (without overriding already-exported shell environment variables).
# - CLI subcommands read from the process environment:
#     set -a; source .env; set +a

# ---------------------------------------------------------------------------
# Option 1 (Quickstart): Google Gemini API
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides (defaults shown):
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Option 2: Standard OpenAI-Compatible Chat Completions Gateway
# (e.g. OpenAI, OpenRouter, LiteLLM, vLLM)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=chat_completions
# LLM_API_KEY=sk-replace-with-your-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Option 3: OpenAI-Compatible Responses API / AgentRouter
# (Default when LLM_PROVIDER is unset; Base URL accepts HTTPS only, with HTTP
# permitted strictly for numeric loopback integration tests; redirects rejected.)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=responses
# AGENTROUTER_API_KEY=sk-ar-replace-with-your-key
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# AGENTROUTER_MODEL=gpt-6.1-sol
# AGENTROUTER_TIMEOUT_SECONDS=60
